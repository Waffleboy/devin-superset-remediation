# Copy to .env and fill in for a LIVE Devin run. Leave DEMO_MODE=true to run
# the full pipeline with scripted Devin trajectories (no keys required).

DEMO_MODE=true

# --- Devin (required when DEMO_MODE=false) ---
# Service-user API key from app.devin.ai -> Settings -> API
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Optional: pin the Playbook id to attach to sessions. If blank, the orchestrator
# looks it up by title (after scripts/bootstrap_playbook.py registers it).
DEVIN_PLAYBOOK_ID=

# --- GitHub (required when DEMO_MODE=false) ---
# PAT with `repo` scope on YOUR Superset fork
GITHUB_TOKEN=
GITHUB_REPO=your-org/superset
GITHUB_WEBHOOK_SECRET=

# --- Live scanning (optional) ---
# Host path to your Superset fork. docker-compose mounts this at /superset.
SUPERSET_CHECKOUT=../superset

# Container path used by scanner.py for live npm audit / pip-audit.
REPO_PATH=/superset

# --- Tuning ---
ENGAGEMENT=superset-secops
SCAN_INTERVAL_HOURS=24
POLL_INTERVAL_SECONDS=60
MAX_CORRECTION_ROUNDS=3
# Escalate a terminal session whose PR's CI never reports a conclusion after this many seconds.
VERIFY_TIMEOUT_SECONDS=3600
REMEDIATE_LABEL=devin-remediate
# The single scoped check the verifier trusts as its independent CI signal
# (emitted by .github/workflows/remediation-verify.yml on the fork). This is why
# Superset's heavy CI matrix — which can't pass on a fork — doesn't corrupt the
# "CI-verified" verdict. Set empty to aggregate ALL checks (legacy behavior).
VERIFY_CHECK_NAME=remediation-verify
